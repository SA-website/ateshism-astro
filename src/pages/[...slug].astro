---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ContentPage from '../layouts/ContentPage.astro';

export async function getStaticPaths() {
  // Local-preview exception: pages with status "review" render only when
  // running `astro dev` (import.meta.env.DEV). Production builds (`astro
  // build`) never include unpublished routes — this only affects local
  // preview, not what gets deployed.
  const pages = await getCollection(
    'pages',
    ({ data }) => data.status === 'published' || (import.meta.env.DEV && data.status === 'review')
  );

  return pages.map((page) => {
    const slug = page.data.permalink === '/'
      ? undefined
      : page.data.permalink.replace(/^\//, '').replace(/\/$/, '');

    return {
      params: { slug },
      props: { page },
    };
  });
}

type Props = {
  page: CollectionEntry<'pages'>;
};

const { page } = Astro.props;
const { Content } = await render(page);
---

<ContentPage page={page}>
  <Content />
</ContentPage>
